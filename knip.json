{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/computeNodeModulesCacheKey.js"],
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["esbuild"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/memory": {
      "project": ["src/**/*.ts"]
    },
    "packages/opener-worker": {
      "entry": ["src/openerWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["@lvce-editor/server"]
    }
  }
}
